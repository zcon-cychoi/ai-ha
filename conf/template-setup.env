# AI-HA — runtime configuration template for aiha-agent (AIHA_AGENT_* and
# AIHA_BACKUP_*) and aiha-framework (AIHA_FRAMEWORK_*).
# Copy and source this file, or export the variables in your environment.
# Backup variables are optional; defaults are shown. Framework variables marked
# "Required" must be set.
#
# The agent reads two prefixes, deliberately kept apart:
#   AIHA_AGENT_*   how to reach the framework (register, run)
#   AIHA_BACKUP_*  the backup repository and its credentials (backup, extract)
# "register" and "run" have no use for repository credentials, so they do not
# read them: a backup job the framework hands out carries its repository, which
# is registered on the framework ("aiha-framework repository add"). The
# repository settings below are for a backup run by hand with "aiha-agent
# backup". The spool and lock settings apply to both. The prefix is still AIHA_BACKUP_* after the aiha-backup CLI was
# absorbed into aiha-agent; renaming it would break existing deployments.
# aiha-rescue links neither: it cannot read any of this.

# Default backup repository URI.
#   Local path : /var/lib/aiha/repo  (or file:///var/lib/aiha/repo)
#   Remote     : sftp://host/path, smb://host/share/path, s3://bucket/prefix
#   Planned    : http(s)://host/path
AIHA_BACKUP_REPOSITORY=./aiha-repo

# Default compression codec: zstd (default) | none
AIHA_BACKUP_COMPRESSION=zstd

# Log level: debug | info | warn | error
AIHA_BACKUP_LOG_LEVEL=info

# Directory holding the lock files that serialize metadata updates between
# concurrent backup processes on the same host (remote repositories only).
# Backing up several partitions at once relies on this, so the directory must be
# writable and identical for every backup process on the host.
AIHA_BACKUP_LOCK_DIR=/run/lock

# --- Resumable transfer (chunked spool for remote backends) ---
# Size each spooled chunk is rolled over at, in bytes (default 64 MiB).
AIHA_BACKUP_CHUNK_SIZE=67108864
# Max unsent bytes buffered on local disk before backpressure (default 2 GiB).
# The spool lives in $TMPDIR (default /tmp) and may use this plus two chunks;
# a backup whose spool filesystem has less free space than that is refused
# before it starts. Lower it on a small root disk, or set TMPDIR elsewhere.
AIHA_BACKUP_BUFFER_CAP=2147483648
# Abort the backup if a chunk cannot upload for this long (default 5m).
AIHA_BACKUP_DISCONNECT_TIMEOUT=5m

# --- SFTP repository (used when AIHA_BACKUP_REPOSITORY is an sftp:// URI) ---
# URI form: sftp://[user@]host[:port]/base/path
#
# SSH user (overrides the user in the URI when set).
AIHA_BACKUP_SFTP_USER=
# Password authentication (leave empty to use key auth).
AIHA_BACKUP_SFTP_PASSWORD=
# Public-key authentication: path to the private key.
AIHA_BACKUP_SFTP_KEY=
# Passphrase for an encrypted private key.
AIHA_BACKUP_SFTP_KEY_PASSPHRASE=
# known_hosts file for host key verification (default: ~/.ssh/known_hosts).
AIHA_BACKUP_SFTP_KNOWN_HOSTS=
# Disable host key verification (INSECURE, off by default). Only for testing.
AIHA_BACKUP_SFTP_INSECURE=false

# --- S3 repository (used when AIHA_BACKUP_REPOSITORY is an s3:// URI) ---
# URI form: s3://bucket/base/prefix
#
# Bucket region (e.g. ap-northeast-2).
AIHA_BACKUP_S3_REGION=
# Static credentials. Leave both empty to use the standard AWS credential chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env, ~/.aws/credentials, IAM role).
AIHA_BACKUP_S3_ACCESS_KEY=
AIHA_BACKUP_S3_SECRET_KEY=
# Session token for temporary (STS) credentials.
AIHA_BACKUP_S3_SESSION_TOKEN=
# Custom endpoint for S3-compatible storage (e.g. minio.example.com:9000).
# Empty means AWS S3.
AIHA_BACKUP_S3_ENDPOINT=
# Use HTTPS (default true). Set false for a plain-HTTP S3-compatible endpoint.
AIHA_BACKUP_S3_USE_SSL=true

# --- SMB/CIFS repository (used when AIHA_BACKUP_REPOSITORY is an smb:// URI) ---
# URI form: smb://[user@]host[:port]/share/base/path
#   (the first path segment is the share name, the rest is the base path)
#
# NTLM user (overrides the user in the URI when set; empty = guest).
AIHA_BACKUP_SMB_USER=
# NTLM password.
AIHA_BACKUP_SMB_PASSWORD=
# NTLM domain / workgroup (optional).
AIHA_BACKUP_SMB_DOMAIN=

# =============================================================================
# Agent — framework connection (aiha-agent register / run)
# =============================================================================

# Required. The https address the agent reaches the framework at.
AIHA_AGENT_FRAMEWORK_URL=

# How the agent verifies the framework. true (default): pin the certificate
# named below, for a self-signed certificate. false: verify the standard way,
# against the system's CA bundle and the host name in the URL, for a publicly
# trusted certificate such as Let's Encrypt. Only true or false are accepted.
AIHA_AGENT_FRAMEWORK_CERT_PIN=true

# Required when AIHA_AGENT_FRAMEWORK_CERT_PIN is true, and must be empty when it
# is false. SHA-256 of the framework certificate's DER bytes, which the agent
# pins. aiha-framework prints it at startup as "certSha256".
AIHA_AGENT_FRAMEWORK_CERT_SHA256=

# The registration token, needed only until the agent has enrolled. Issue one
# with "aiha-framework agent token issue". It is spent by a successful
# enrolment: remove it from this file afterwards.
#
# It is not a command-line flag on purpose — a flag is visible to every process
# on the host through the process list. Use the file form below to keep it out
# of the environment of processes the agent starts.
AIHA_AGENT_REGISTRATION_TOKEN=
# A file holding the registration token instead. When set, it wins.
AIHA_AGENT_REGISTRATION_TOKEN_FILE=

# Where the agent keeps its identity and credentials. This directory is
# excluded from the agent's own backups, so that a restored system does not
# come up holding them. Moving it moves the exclusion with it.
AIHA_AGENT_STATE_DIR=/var/lib/aiha

# How long each long poll asks the framework to hold, between 5s and 45s.
# Reaching the framework is also what reports the agent alive, so a longer wait
# is cheaper but slower to notice an outage.
AIHA_AGENT_POLL_WAIT=45s

# How often the agent reports what this system is made of, so that a backup can
# be asked for without naming its partitions by hand. Minimum 5m; each report
# reads the disks. A partition layout changes rarely, so the default is
# generous; the framework records when each report was collected, so a stale one
# is visible rather than silent. A report that fails is retried with backoff
# rather than waiting out the interval.
AIHA_AGENT_INVENTORY_INTERVAL=1h

# Log level: debug | info | warn | error
AIHA_AGENT_LOG_LEVEL=info

# =============================================================================
# Framework server — aiha-framework
# =============================================================================

# HTTPS port the framework listens on.
AIHA_FRAMEWORK_PORT=8443

# Required. Server certificate and key (PEM). With AIHA_FRAMEWORK_CERT_PIN=true,
# agents connect only to the certificate whose SHA-256 over its DER bytes they
# were given; aiha-framework prints that fingerprint at startup, on
# "agent token issue" and on "restore create". A self-signed certificate is
# enough, e.g.:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
#     -days 365 -subj /CN=aiha-framework -keyout framework.key -out framework.crt
AIHA_FRAMEWORK_TLS_CERT=
AIHA_FRAMEWORK_TLS_KEY=

# How agents are told to verify the certificate above, in what "agent token
# issue" and "restore create" print. true (default): pin its fingerprint, for a
# self-signed certificate. false: verify it against the agent's CA bundle and
# the host name in AIHA_FRAMEWORK_PUBLIC_URL, for a publicly trusted certificate
# such as Let's Encrypt. Only true or false are accepted.
AIHA_FRAMEWORK_CERT_PIN=true

# Required. PostgreSQL connection string. It holds a password: keep this file
# private and never commit a filled-in copy.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
AIHA_FRAMEWORK_DB_DSN=

# Required for "server" and for "repository add|update-credentials". A file
# holding 64 hexadecimal digits (32 bytes): the key that encrypts the backup
# repository credentials kept in the database. Create it once, e.g.:
#   ( umask 077; openssl rand -hex 32 > secret.key )
# Keep it out of the database and its backups. If it is lost, the stored
# credentials cannot be read: create a new key and enter each repository's
# credentials again with "aiha-framework repository update-credentials" — the
# repositories keep their IDs, so existing jobs and backup sets stay valid.
AIHA_FRAMEWORK_SECRET_KEY_FILE=

# Required for "agent token issue" and "restore create". The https address
# agents reach the framework at, e.g. a port-forwarded https://host:port. It is
# printed into the agent settings and the instance init script values.
AIHA_FRAMEWORK_PUBLIC_URL=

# How long a new restore job accepts its first claim.
AIHA_FRAMEWORK_CLAIM_TTL=30m
# How long after a claim the same request key may fetch the response again,
# e.g. after a lost response.
AIHA_FRAMEWORK_CLAIM_REDELIVERY=10m

# Log level: debug | info | warn | error
AIHA_FRAMEWORK_LOG_LEVEL=info

# Browser origins allowed to call the API, comma-separated. Empty leaves CORS
# off, which is the right setting unless a browser app calls the API: rescue
# agents are not browsers and never send an Origin.
AIHA_FRAMEWORK_CORS_ORIGINS=

# Serve the OpenAPI document at GET /aiha/swagger.json (default false). It
# describes the API to anyone who can reach the port, so leave it off where the
# framework is exposed and turn it on for local development.
AIHA_FRAMEWORK_SWAGGER=false

# --- Backup job queue ---
# How long a job waits for its agent before it is failed.
AIHA_FRAMEWORK_JOB_TTL=24h
# How long a claimed job may go without reporting that it started before it is
# returned to the queue. Safe to requeue: nothing has been written yet.
AIHA_FRAMEWORK_JOB_CLAIMED_TIMEOUT=5m
# How often agents are told to report while a job runs, whether or not the work
# has advanced. A report is what renews the lease.
AIHA_FRAMEWORK_JOB_PROGRESS_INTERVAL=10s
# How long one report keeps an attempt's lease. Must be at least three times
# the progress interval, or one late report costs a healthy agent its job. When
# a running job's lease lapses the job is failed, not handed to another agent:
# the first may still be writing.
AIHA_FRAMEWORK_JOB_LEASE=90s
# How often timed-out jobs are moved on.
AIHA_FRAMEWORK_JOB_SWEEP_INTERVAL=30s
